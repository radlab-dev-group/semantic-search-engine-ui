{
  "api_hosts": {
    "semantic_search_engine": {
      "host": "http://192.168.100.70:8271",
      "prefix": "api",
      "verify_tls": true,
      "ep": {
        "login": "login",
        "logout": "logout",
        "login_url": "login_url",
        "refresh_token": "refresh_token",
        "collections": "collections",
        "documents": "documents",
        "document_content": "document_content",
        "generative_models": "generative_models",
        "new_chat": "new_chat",
        "add_user_message": "add_user_message",
        "chats": "chats",
        "rate_generative_answer": "rate_generative_answer",
        "healthz": "healthz"
      }
    }
  },
  "auth": {
    "mode": "local",
    "sso_button": false
  },
  "ui": {
    "default_language": "pl",
    "languages": ["pl", "en"],
    "brand": "radlab.dev",
    "history_limit": 50
  },
  "timeouts": {
    "default_s": 30,
    "add_user_message_s": 150
  },
  "defaults": {
    "options": {
      "generative_model": "",
      "percentage_rank_mass": 100,
      "use_doc_names_in_response": true,
      "use_rag_supervisor": true,
      "user_msg_is_rag_question": true,
      "use_content_supervisor": false,
      "use_intelligent_query_rewrite": false,
      "translate_answer": false,
      "top_k": 50,
      "top_p": 0.95,
      "temperature": 0.65,
      "typical_p": 1.0,
      "repetition_penalty": 1.1
    },
    "search_options": {
      "max_results": 8,
      "hybrid_search": true,
      "rerank_results": false,
      "min_similarity": 0.5
    },
    "document_preview_pages": 3
  },
  "citation_instruction": "After each sentence based on the documents, give the full name of the document the information comes from in square brackets, e.g. [Annual report 2025.pdf]. Cite only documents from the context. Do not give page numbers.",
  "default_format": "bullets",
  "formats": [
    {
      "id": "brief",
      "label": {
        "pl": "Zwięźle", "en": "Brief"
      },
      "description": {
        "pl": "2–4 zdania, najważniejsze na początku", "en": "2–4 sentences, key point first"
      },
      "max_new_tokens": 300,
      "system_prompt": "Answer briefly, in 2-4 sentences. Start with the most important information."
    },
    {
      "id": "bullets",
      "label": {
        "pl": "W punktach", "en": "Bullet points"
      },
      "description": {
        "pl": "Lista najważniejszych informacji", "en": "List of key points"
      },
      "max_new_tokens": 700,
      "system_prompt": "Answer as a Markdown list of 3-7 bullet points. Each point starts with a bolded heading."
    },
    {
      "id": "detailed",
      "label": {
        "pl": "Szczegółowo", "en": "Detailed"
      },
      "description": {
        "pl": "Podsumowanie, sekcje, wnioski i zastrzeżenia", "en": "Summary, sections, conclusions, caveats"
      },
      "max_new_tokens": 1500,
      "system_prompt": "Answer comprehensively in Markdown: start with a 2-sentence summary, then sections with headings (###), and end with conclusions and information that was not found in the documents."
    },
    {
      "id": "table",
      "label": {
        "pl": "Tabela", "en": "Table"
      },
      "description": {
        "pl": "Zestawienie w kolumnach – do porównań", "en": "Columns – for comparisons"
      },
      "max_new_tokens": 900,
      "system_prompt": "Answer as a Markdown table. The last column is the source in square brackets. Below the table, one summary sentence."
    }
  ],
  "features": {
    "chat_sections": false
  }
}
